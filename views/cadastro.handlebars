<form class="login-criar-conta" method="POST" action="/cadastro">
  <p>Insira suas informações para criar sua nova conta </p>

  {{#if erro}}
  <div class="msg-erro">{{erro}}</div>
  {{/if}}

  <div class="input-wrapper">
    <label for="nome" class="label-nome">Nome Completo</label>
    <input type="text" id="nome" name="nome" value="{{valores.nome}}" placeholder="Nome Completo" class="input-1" required />
    <label for="cpf" class="label-cpf">CPF</label>
    <input type="text" id="cpf" name="cpf" value="{{valores.cpf}}" placeholder="CPF" inputmode="numeric" maxlength="14" class="input-1" required />
    <label for="email" class="label-email">E-mail</label>
    <input type="email" id="email" name="email" value="{{valores.email}}" placeholder="E-mail" class="input-2" required />
    <label for="telefone" class="label-telefone">Telefone</label>
    <div class="input-telefone">
      <input type="text" name="ddd" value="{{valores.ddd}}" placeholder="DDD" inputmode="numeric" maxlength="2" class="input-2" />
      <input type="text" id="telefone" name="telefone" value="{{valores.telefone}}" placeholder="Telefone" inputmode="numeric" maxlength="10" class="input-2" />
    </div>
    <label for="cep" class="label-endereco">Endereco</label>
    <input type="text" id="cep" name="cep" value="{{valores.cep}}" placeholder="CEP" inputmode="numeric" maxlength="9" class="input-3" />
    <input type="text" name="rua" value="{{valores.rua}}" placeholder="Rua" class="input-3" />
    <input type="text" name="bairro" value="{{valores.bairro}}" placeholder="Bairro" class="input-3" />
    <input type="text" name="numero" value="{{valores.numero}}" placeholder="numero" class="input-3" />
    <input type="text" name="complemento" value="{{valores.complemento}}" placeholder="Complemento" class="input-3" />
    <label for="senha" class="label-senha">Senha</label>
    <input type="password" id="senha" name="senha" placeholder="Senha" minlength="6" class="input-4" required />
    <input type="password" name="confirmarSenha" placeholder="Confirmar Senha" minlength="6" class="input-4" required />
  </div>
  <div class="btn-cadastro">
    <button type="submit" class="btn-cadastrar">Criar Conta</button>
  </div>
</form>
