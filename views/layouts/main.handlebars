<!DOCTYPE html>
<html lang="pt-br">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- css: da página (se houver), depois cabeçalho e rodapé (ordem importa) -->
  {{#if css}}
  <link rel="stylesheet" href="/css/{{css}}.css">
  {{/if}}
  <link rel="stylesheet" href="/css/cabecalho.css">
  {{#unless semRodape}}
  <link rel="stylesheet" href="/css/rodape.css">
  {{/unless}}

  <!-- importações (bootstrap só na página principal, googleFonts) -->
  {{#if bootstrap}}
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT" crossorigin="anonymous">
  {{/if}}
  <link href='https://fonts.googleapis.com/css?family=Kdam Thmor Pro' rel='stylesheet'>

  <!-- ícone da página -->
  <link rel="shortcut icon" href="/img/image_3-removebg-preview 1.png" type="image/x-icon">
  <title>{{titulo}}</title>
</head>

<body>
  {{#unless semCabecalho}}
  {{> cabecalho}}
  {{/unless}}

  {{{body}}}

  {{#unless semRodape}}
  {{> rodape}}
  {{/unless}}

  {{#if bootstrap}}
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-j1CDi7MgGQ12Z7Qab0qlWQ/Qqz24Gc6BM0thvEMVjHnfYGF0rmFCozFSxQBxwHKO"
    crossorigin="anonymous"></script>
  {{/if}}
  {{#if js}}
  <script src="/js/{{js}}.js"></script>
  {{/if}}
  <script src="/js/cabecalho.js"></script>
</body>

</html>
